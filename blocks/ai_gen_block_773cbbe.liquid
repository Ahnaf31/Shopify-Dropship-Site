{% doc %}
  @prompt
    i need testimonial section, the testimonial you built is nice. But I think if I could add blokc her ber testimonial then I can add upto 5-10 maybe. and I can add a slider her to see the testimonila detisl. this desing is fine 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonials-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-testimonials-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-testimonials-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 40px;
  }

  .ai-testimonials-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 12px;
  }

  .ai-testimonials-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
  }

  .ai-testimonials-slider-wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-testimonials-slider-{{ ai_gen_id }} {
    overflow: hidden;
    position: relative;
  }

  .ai-testimonials-track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease;
  }

  .ai-testimonials-slide-{{ ai_gen_id }} {
    min-width: calc((100% - ({{ block.settings.grid_gap }}px * ({{ block.settings.columns_desktop }} - 1))) / {{ block.settings.columns_desktop }});
    margin-right: {{ block.settings.grid_gap }}px;
    flex-shrink: 0;
  }

  .ai-testimonial-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    padding: {{ block.settings.card_padding }}px;
    border-radius: {{ block.settings.card_border_radius }}px;
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    display: flex;
    flex-direction: column;
    gap: 16px;
    height: 100%;
  }

  .ai-testimonial-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    color: {{ block.settings.star_color }};
  }

  .ai-testimonial-stars-{{ ai_gen_id }} svg {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: currentColor;
  }

  .ai-testimonial-quote-{{ ai_gen_id }} {
    font-size: {{ block.settings.quote_size }}px;
    line-height: 1.6;
    color: {{ block.settings.quote_color }};
    margin: 0;
  }

  .ai-testimonial-author-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
  }

  .ai-testimonial-avatar-{{ ai_gen_id }} {
    width: {{ block.settings.avatar_size }}px;
    height: {{ block.settings.avatar_size }}px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
  }

  .ai-testimonial-avatar-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-testimonial-avatar-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.card_border_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.avatar_size | divided_by: 2 }}px;
    font-weight: 600;
  }

  .ai-testimonial-author-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ai-testimonial-author-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.author_name_size }}px;
    font-weight: 600;
    color: {{ block.settings.heading_color }};
    margin: 0;
  }

  .ai-testimonial-author-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.author_title_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
  }

  .ai-testimonials-controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 30px;
  }

  .ai-testimonials-arrow-{{ ai_gen_id }} {
    background-color: {{ block.settings.arrow_background }};
    color: {{ block.settings.arrow_color }};
    border: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .ai-testimonials-arrow-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-testimonials-arrow-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-testimonials-arrow-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-testimonials-dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-testimonials-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.3;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .ai-testimonials-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-testimonials-slide-{{ ai_gen_id }} {
      min-width: calc((100% - ({{ block.settings.grid_gap }}px * ({{ block.settings.columns_mobile }} - 1))) / {{ block.settings.columns_mobile }});
    }

    .ai-testimonials-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-testimonials-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<testimonials-slider-{{ ai_gen_id }}
  class="ai-testimonials-{{ ai_gen_id }}"
  data-columns-desktop="{{ block.settings.columns_desktop }}"
  data-columns-mobile="{{ block.settings.columns_mobile }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-testimonials-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-testimonials-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-testimonials-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <div class="ai-testimonials-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-testimonials-slider-wrapper-{{ ai_gen_id }}">
      <div class="ai-testimonials-slider-{{ ai_gen_id }}">
        <div class="ai-testimonials-track-{{ ai_gen_id }}">
          {% for i in (1..10) %}
            {% liquid
              assign rating_key = 'testimonial_' | append: i | append: '_rating'
              assign quote_key = 'testimonial_' | append: i | append: '_quote'
              assign name_key = 'testimonial_' | append: i | append: '_name'
              assign title_key = 'testimonial_' | append: i | append: '_title'
              assign avatar_key = 'testimonial_' | append: i | append: '_avatar'

              assign rating = block.settings[rating_key]
              assign quote = block.settings[quote_key]
              assign name = block.settings[name_key]
              assign title = block.settings[title_key]
              assign avatar = block.settings[avatar_key]
            %}

            {% if quote != blank or name != blank %}
              <div class="ai-testimonials-slide-{{ ai_gen_id }}">
                <div class="ai-testimonial-card-{{ ai_gen_id }}">
                  {% if block.settings.show_stars %}
                    <div class="ai-testimonial-stars-{{ ai_gen_id }}">
                      {% for star in (1..5) %}
                        {% if star <= rating %}
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                          </svg>
                        {% else %}
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                          </svg>
                        {% endif %}
                      {% endfor %}
                    </div>
                  {% endif %}

                  {% if quote != blank %}
                    <p class="ai-testimonial-quote-{{ ai_gen_id }}">{{ quote }}</p>
                  {% endif %}

                  <div class="ai-testimonial-author-{{ ai_gen_id }}">
                    <div class="ai-testimonial-avatar-{{ ai_gen_id }}">
                      {% if avatar %}
                        <img
                          src="{{ avatar | image_url: width: 100 }}"
                          alt="{{ name | escape }}"
                          width="100"
                          height="100"
                          loading="lazy"
                        >
                      {% else %}
                        <div class="ai-testimonial-avatar-placeholder-{{ ai_gen_id }}">
                          {% if name != blank %}
                            {{ name | slice: 0 }}
                          {% else %}
                            ?
                          {% endif %}
                        </div>
                      {% endif %}
                    </div>
                    <div class="ai-testimonial-author-info-{{ ai_gen_id }}">
                      {% if name != blank %}
                        <div class="ai-testimonial-author-name-{{ ai_gen_id }}">{{ name }}</div>
                      {% endif %}
                      {% if title != blank %}
                        <div class="ai-testimonial-author-title-{{ ai_gen_id }}">{{ title }}</div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <div class="ai-testimonials-controls-{{ ai_gen_id }}">
        <button class="ai-testimonials-arrow-{{ ai_gen_id }} ai-testimonials-prev-{{ ai_gen_id }}" aria-label="Previous testimonials">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div class="ai-testimonials-dots-{{ ai_gen_id }}"></div>

        <button class="ai-testimonials-arrow-{{ ai_gen_id }} ai-testimonials-next-{{ ai_gen_id }}" aria-label="Next testimonials">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </div>
</testimonials-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class TestimonialsSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-testimonials-track-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-testimonials-slide-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-testimonials-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-testimonials-next-{{ ai_gen_id }}');
        this.dotsContainer = this.querySelector('.ai-testimonials-dots-{{ ai_gen_id }}');
        this.controlsWrapper = this.querySelector('.ai-testimonials-controls-{{ ai_gen_id }}');

        this.columnsDesktop = parseInt(this.dataset.columnsDesktop);
        this.columnsMobile = parseInt(this.dataset.columnsMobile);
        this.totalSlides = this.slides.length;

        if (this.totalSlides === 0) {
          if (this.controlsWrapper) {
            this.controlsWrapper.style.display = 'none';
          }
          return;
        }

        this.setupEventListeners();
        this.createDots();
        this.updateSlider();
        this.checkControls();
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.prev());
        }
        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.next());
        }

        window.addEventListener('resize', () => {
          this.updateSlider();
          this.checkControls();
        });
      }

      checkControls() {
        const columns = this.getColumns();
        if (this.controlsWrapper) {
          if (this.totalSlides <= columns) {
            this.controlsWrapper.style.display = 'none';
          } else {
            this.controlsWrapper.style.display = 'flex';
          }
        }
      }

      createDots() {
        if (!this.dotsContainer) return;

        const columns = this.getColumns();
        const totalDots = Math.ceil(this.totalSlides / columns);

        this.dotsContainer.innerHTML = '';

        for (let i = 0; i < totalDots; i++) {
          const dot = document.createElement('button');
          dot.classList.add('ai-testimonials-dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
          dot.addEventListener('click', () => this.goToSlide(i * columns));
          this.dotsContainer.appendChild(dot);
        }

        this.updateDots();
      }

      getColumns() {
        return window.innerWidth <= 749 ? this.columnsMobile : this.columnsDesktop;
      }

      prev() {
        const columns = this.getColumns();
        this.currentIndex = Math.max(0, this.currentIndex - columns);
        this.updateSlider();
      }

      next() {
        const columns = this.getColumns();
        const maxIndex = this.totalSlides - columns;
        this.currentIndex = Math.min(maxIndex, this.currentIndex + columns);
        this.updateSlider();
      }

      goToSlide(index) {
        this.currentIndex = index;
        this.updateSlider();
      }

      updateSlider() {
        if (!this.track) return;

        const columns = this.getColumns();
        const slideWidth = 100 / columns;
        const gap = {{ block.settings.grid_gap }};
        const gapPercentage = (gap * (columns - 1)) / this.track.offsetWidth * 100;
        const adjustedSlideWidth = (100 - gapPercentage) / columns;
        const offset = this.currentIndex * (adjustedSlideWidth + (gapPercentage / (columns - 1)));

        this.track.style.transform = 'translateX(-' + offset + '%)';

        this.updateButtons();
        this.updateDots();
      }

      updateButtons() {
        const columns = this.getColumns();
        const maxIndex = this.totalSlides - columns;

        if (this.prevButton) {
          this.prevButton.disabled = this.currentIndex === 0;
        }

        if (this.nextButton) {
          this.nextButton.disabled = this.currentIndex >= maxIndex;
        }
      }

      updateDots() {
        if (!this.dotsContainer) return;

        const dots = this.dotsContainer.querySelectorAll('.ai-testimonials-dot-{{ ai_gen_id }}');
        const columns = this.getColumns();
        const activeDotIndex = Math.floor(this.currentIndex / columns);

        dots.forEach(function(dot, index) {
          if (index === activeDotIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }
    }

    customElements.define('testimonials-slider-{{ ai_gen_id }}', TestimonialsSlider{{ ai_gen_id }});
  })();
</script>

