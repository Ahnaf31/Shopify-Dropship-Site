{%- doc -%}
  Tiered buy-box block.
  - Renders quantity tiers (1x / 2x / 3x ...) with per-unit pricing.
  - Automatically detects the product's real options:
      * no real variants        -> no option selectors at all
      * Color only              -> one Color dropdown per unit
      * Color + Size            -> both dropdowns per unit
      * any number of options   -> one dropdown per option, per unit
  - Each unit in a bundle can be configured independently.
  - Resolves the exact variant from the FULL option combination.
  - Single AJAX add-to-cart call containing one line item per unit.
{%- enddoc -%}
{% liquid
  assign product = closest.product
  assign variant = product.selected_or_first_available_variant
  # A product has "real" options only when it is not the Default Title variant
  assign has_options = false
  unless product.has_only_default_variant
    assign has_options = true
  endunless
  # Price the tiers are calculated from
  if block.settings.price_basis == 'compare_at' and variant.compare_at_price > variant.price
    assign base_price = variant.compare_at_price
  else
    assign base_price = variant.price
  endif
  # The struck-through "was" price, only shown when it is genuine
  assign was_price = variant.price
  if variant.compare_at_price > variant.price
    assign was_price = variant.compare_at_price
  endif
  assign max_tiers = 5
%}
<buy-box-tiers
  class="buy-box-tiers"
  data-product-id="{{ product.id }}"
  data-has-options="{% if has_options %}true{% else %}false{% endif %}"
  data-option-count="{% if has_options %}{{ product.options_with_values.size }}{% else %}0{% endif %}"
  data-default-variant-id="{{ variant.id }}"
  data-sold-out-text="{{ block.settings.sold_out_text | escape }}"
  data-unavailable-text="{{ block.settings.unavailable_text | escape }}"
  data-adding-text="{{ block.settings.adding_text | escape }}"
  data-add-text="{{ block.settings.add_to_cart_text | escape }}"
  data-redirect-to-cart="{{ block.settings.redirect_to_cart }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <p class="buy-box-tiers__heading">{{ block.settings.heading }}</p>
  {% endif %}
  <fieldset class="buy-box-tiers__tiers">
    <legend class="visually-hidden">{{ block.settings.heading | default: 'Choose a bundle' }}</legend>
    {% for i in (1..max_tiers) %}
      {% liquid
        case i
          when 1
            assign tier_enabled = block.settings.tier_1_enabled
            assign qty = block.settings.tier_1_quantity
            assign discount = product.metafields.custom.tier_1_discount.value | default: 0
            assign label = block.settings.tier_1_label
            assign badge = block.settings.tier_1_badge
          when 2
            assign tier_enabled = block.settings.tier_2_enabled
            assign qty = block.settings.tier_2_quantity
            assign discount = product.metafields.custom.tier_2_discount.value | default: 0
            assign label = block.settings.tier_2_label
            assign badge = block.settings.tier_2_badge
          when 3
            assign tier_enabled = block.settings.tier_3_enabled
            assign qty = block.settings.tier_3_quantity
            assign discount = product.metafields.custom.tier_3_discount.value | default: 0
            assign label = block.settings.tier_3_label
            assign badge = block.settings.tier_3_badge
          when 4
            assign tier_enabled = block.settings.tier_4_enabled
            assign qty = block.settings.tier_4_quantity
            assign discount = product.metafields.custom.tier_4_discount.value | default: 0
            assign label = block.settings.tier_4_label
            assign badge = block.settings.tier_4_badge
          when 5
            assign tier_enabled = block.settings.tier_5_enabled
            assign qty = block.settings.tier_5_quantity
            assign discount = product.metafields.custom.tier_5_discount.value | default: 0
            assign label = block.settings.tier_5_label
            assign badge = block.settings.tier_5_badge
        endcase
        assign qty = qty | at_least: 1
        assign discount = discount | default: 0 | at_least: 0 | at_most: 100
        assign discount_amount = base_price | times: discount | divided_by: 100
        assign unit_price = base_price | minus: discount_amount
        assign tier_total = unit_price | times: qty
        assign is_default = false
        if block.settings.default_tier == i
          assign is_default = true
        endif
      %}
      {% if tier_enabled %}
        <label
          class="buy-box-tiers__tier{% if is_default %} buy-box-tiers__tier--checked{% endif %}"
          data-tier
          data-quantity="{{ qty }}"
        >
          <div class="buy-box-tiers__tier-row">
            <input
              type="radio"
              name="buy-box-tier-{{ block.id }}"
              value="{{ i }}"
              data-quantity="{{ qty }}"
              data-discount="{{ discount }}"
              {% if is_default %}
                checked
              {% endif %}
            >
            <span class="buy-box-tiers__tier-info">
              <span class="buy-box-tiers__tier-label">{{ label | default: qty | append: 'x' }}</span>
              {% if badge != blank %}
                <span class="buy-box-tiers__badge">{{ badge }}</span>
              {% endif %}
              {% if discount > 0 and block.settings.show_save_text %}
                <span class="buy-box-tiers__tier-save">
                  {{ block.settings.save_text }} {{ discount }}%
                </span>
              {% endif %}
            </span>
            <span class="buy-box-tiers__tier-price">
              <span class="buy-box-tiers__price-now">
                {{ unit_price | money }}
                {% if block.settings.show_per_unit %}
                  <span class="buy-box-tiers__per-unit">{{ block.settings.per_unit_text }}</span>
                {% endif %}
              </span>
              {% if unit_price < was_price %}
                <s class="buy-box-tiers__price-was">{{ was_price | money }}</s>
              {% endif %}
              {% if qty > 1 and block.settings.show_tier_total %}
                <span class="buy-box-tiers__tier-total">{{ tier_total | money }} {{ block.settings.total_text }}</span>
              {% endif %}
            </span>
          </div>

          {% liquid
            assign option_names = product.options_with_values | map: 'name'
            assign option_names_joined = option_names | join: ' & '
            if option_names.size > 0
              assign options_heading = 'Choose your ' | append: option_names_joined
            else
              assign options_heading = 'Choose your options'
            endif
          %}
          {% comment %} Option selectors only exist when the product actually has options {% endcomment %}
         {% if has_options %}
        <div class="buy-box-tiers__tier-colors-wrap" data-tier-colors-wrap>
          <div class="buy-box-tiers__tier-colors" data-tier-colors>
            {% if options_heading != blank %}
              <span class="buy-box-tiers__color-heading">{{ options_heading }}</span>
            {% endif %}
            <div class="buy-box-tiers__color-list" data-option-list></div>
          </div>
        </div>
      {% endif %}
        </label>
      {% endif %}
    {% endfor %}
  </fieldset>
  {% if has_options %}
    {% comment %} One reusable option group = one unit of the bundle {% endcomment %}
    <template data-option-group-template>
      <div class="buy-box-tiers__color-row" data-option-group>
        {% if block.settings.show_swatch %}
          <img
            class="buy-box-tiers__swatch"
            data-swatch-img
            src="{{ variant.featured_media | image_url: width: 60 }}"
            alt=""
            width="28"
            height="28"
            loading="lazy"
          >
        {% endif %}
        <div class="buy-box-tiers__selects">
          {% for option in product.options_with_values %}
            <select
              class="buy-box-tiers__select"
              data-option-select
              data-option-index="{{ forloop.index0 }}"
              aria-label="{{ option.name | escape }}"
            >
              {% for value in option.values %}
                <option value="{{ value | escape }}">{{ value }}</option>
              {% endfor %}
            </select>
          {% endfor %}
        </div>
        <span class="buy-box-tiers__unit-status" data-unit-status hidden></span>
      </div>
    </template>
    <script type="application/json" data-variant-data>
      [
        {%- for v in product.variants -%}
          {
            "id": {{ v.id }},
            "options": {{ v.options | json }},
            "available": {{ v.available }},
            "price": {{ v.price }},
            "image": {{ v.featured_media | image_url: width: 120 | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    </script>
  {% endif %}
  <button
    type="button"
    class="button buy-box-tiers__add-to-cart"
    ref="addToCartBtn"
    {% unless product.available %}
      disabled
    {% endunless %}
  >
    {% if product.available %}
      {{ block.settings.add_to_cart_text }}
    {% else %}
      {{ block.settings.sold_out_text }}
    {% endif %}
  </button>
  <p class="buy-box-tiers__error" ref="errorMsg" hidden></p>
</buy-box-tiers>
<script src="{{ 'buy-box-tiers.js' | asset_url }}" type="module"></script>
{% stylesheet %}
  .buy-box-tiers,
  .buy-box-tiers * {
    box-sizing: border-box;
  }
  .buy-box-tiers {
    width: 100%;
    container-type: inline-size;
    container-name: buybox;
  }
  .buy-box-tiers label:has(input[type='radio']) {
    display: block;
  }
  .buy-box-tiers__heading {
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-foreground-secondary);
    text-align: center;
    margin: 0 0 12px;
  }
  .buy-box-tiers__tiers {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border: none;
    padding: 0;
    margin: 0;
  }
  .buy-box-tiers__tier {
    display: block;
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 14px 16px;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .buy-box-tiers__tier--checked {
    border-color: var(--color-foreground);
    border-width: 2px;
    padding: 13px 15px;
    background: rgb(var(--color-foreground-rgb) / var(--opacity-5));
  }
  .buy-box-tiers__tier-row {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 10px;
    width: 100%;
  }
  .buy-box-tiers__tier-row input {
    margin: 0;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
  }
  .buy-box-tiers__tier-info {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 8px;
    row-gap: 2px;
    flex: 1 1 0;
    min-width: 0;
  }
  .buy-box-tiers__tier-label {
    font-weight: 600;
    font-size: 15px;
    white-space: nowrap;
  }
 .buy-box-tiers__badge {
    display: inline-flex;
    align-items: center;
    font-size: 11px;
    line-height: 1;
    font-weight: 600;
    color: #fff;
    background: #007bff;
    padding: 4px 10px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .buy-box-tiers__tier-save {
    font-size: 12px;
    color: var(--color-foreground-secondary);
    white-space: nowrap;
    flex-basis: 100%;
  }
  .buy-box-tiers__tier-price {
    flex: 0 0 auto;
    text-align: right;
    white-space: nowrap;
  }
  .buy-box-tiers__price-now {
    font-weight: 600;
    font-size: 15px;
  }
  .buy-box-tiers__per-unit {
    font-size: 12px;
    opacity: 0.6;
    margin-inline-start: 2px;
  }
  .buy-box-tiers__price-was {
    display: block;
    opacity: 0.5;
    font-size: 13px;
  }
  .buy-box-tiers__tier-total {
    display: block;
    font-size: 12px;
    color: var(--color-foreground-secondary);
  }
  .buy-box-tiers__tier-colors-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.25s ease;
    width: 100%;
  }
  .buy-box-tiers__tier--checked .buy-box-tiers__tier-colors-wrap {
    grid-template-rows: 1fr;
  }
  .buy-box-tiers__tier-colors {
    overflow: hidden;
    min-width: 0;
    width: 100%;
  }
  .buy-box-tiers__tier--checked .buy-box-tiers__tier-colors {
    padding-top: 12px;
  }
  .buy-box-tiers__color-heading {
    display: block;
    font-size: 13px;
    color: var(--color-foreground-secondary);
    margin-bottom: 8px;
    padding-left: 28px;
  }
  .buy-box-tiers__color-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .buy-box-tiers__color-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-left: 28px;
    width: 100%;
  }
  .buy-box-tiers__swatch {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    object-fit: cover;
    flex-shrink: 0;
    background: #eee;
  }
  .buy-box-tiers__selects {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    flex: 1 1 auto;
    min-width: 0;
  }
  .buy-box-tiers__select {
    flex: 1 1 120px;
    min-width: 0;
    max-width: 220px;
    padding: 6px 10px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-background);
    font-size: 13px;
  }
  .buy-box-tiers__unit-status {
    font-size: 12px;
    color: var(--color-error, #d02e2e);
    flex-basis: 100%;
    padding-left: 38px;
  }
  .buy-box-tiers__add-to-cart {
    width: 100%;
    margin-top: 16px;
  }
  .buy-box-tiers__error {
    color: var(--color-error, #d02e2e);
    font-size: 13px;
    margin-top: 8px;
  }
  /* Reacts to the actual width of the buy-box, not the viewport */
  @container buybox (max-width: 360px) {
    .buy-box-tiers__tier {
      padding: 12px;
    }
    .buy-box-tiers__tier--checked {
      padding: 11px;
    }
    .buy-box-tiers__tier-row {
      flex-wrap: wrap;
    }
    .buy-box-tiers__tier-price {
      flex: 1 1 100%;
      text-align: left;
      margin-left: 28px;
    }
    .buy-box-tiers__color-heading,
    .buy-box-tiers__color-row {
      padding-left: 0;
    }
    .buy-box-tiers__selects {
      flex-direction: column;
    }
    .buy-box-tiers__select {
      max-width: none;
      width: 100%;
    }
    .buy-box-tiers__unit-status {
      padding-left: 0;
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Buy Box Tiers",
  "settings": [
    { "type": "header", "content": "General" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Buy more - save more" },
    {
      "type": "select",
      "id": "price_basis",
      "label": "Calculate tier prices from",
      "options": [
        { "value": "price", "label": "Current price" },
        { "value": "compare_at", "label": "Compare-at price" }
      ],
      "default": "price"
    },
    {
      "type": "range",
      "id": "default_tier",
      "label": "Tier selected by default",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 2
    },
    { "type": "checkbox", "id": "redirect_to_cart", "label": "Go to cart after adding", "default": false },
    { "type": "header", "content": "Display" },
    { "type": "checkbox", "id": "show_per_unit", "label": "Show per-unit label", "default": true },
    { "type": "checkbox", "id": "show_tier_total", "label": "Show bundle total", "default": false },
    { "type": "checkbox", "id": "show_save_text", "label": "Show savings text", "default": true },
    { "type": "checkbox", "id": "show_swatch", "label": "Show variant image next to selectors", "default": true },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "per_unit_text", "label": "Per-unit text", "default": "/unit" },
    { "type": "text", "id": "total_text", "label": "Bundle total text", "default": "total" },
    { "type": "text", "id": "save_text", "label": "Savings text", "default": "You save" },
    { "type": "text", "id": "add_to_cart_text", "label": "Add to cart button", "default": "Add to cart" },
    { "type": "text", "id": "adding_text", "label": "Adding state text", "default": "Adding..." },
    { "type": "text", "id": "sold_out_text", "label": "Sold out text", "default": "Sold out" },
    {
      "type": "text",
      "id": "unavailable_text",
      "label": "Unavailable combination text",
      "default": "This combination is unavailable"
    },
    { "type": "header", "content": "Tier 1 — discount from product metafield:" },
    { "type": "checkbox", "id": "tier_1_enabled", "label": "Show this tier", "default": true },
    { "type": "text", "id": "tier_1_label", "label": "Label", "default": "1x" },
    { "type": "text", "id": "tier_1_badge", "label": "Badge (optional)" },
    { "type": "number", "id": "tier_1_quantity", "label": "Quantity", "default": 1 },
    { "type": "header", "content": "Tier 2 — discount from product metafield:" },
    { "type": "checkbox", "id": "tier_2_enabled", "label": "Show this tier", "default": true },
    { "type": "text", "id": "tier_2_label", "label": "Label", "default": "2x" },
    { "type": "text", "id": "tier_2_badge", "label": "Badge (optional)" },
    { "type": "number", "id": "tier_2_quantity", "label": "Quantity", "default": 2 },
    { "type": "header", "content": "Tier 3 — discount from product metafield:" },
    { "type": "checkbox", "id": "tier_3_enabled", "label": "Show this tier", "default": true },
    { "type": "text", "id": "tier_3_label", "label": "Label", "default": "3x" },
    { "type": "text", "id": "tier_3_badge", "label": "Badge (optional)", "default": "Best Value!" },
    { "type": "number", "id": "tier_3_quantity", "label": "Quantity", "default": 3 },
    { "type": "header", "content": "Tier 4 — discount from product metafield:" },
    { "type": "checkbox", "id": "tier_4_enabled", "label": "Show this tier", "default": false },
    { "type": "text", "id": "tier_4_label", "label": "Label", "default": "4x" },
    { "type": "text", "id": "tier_4_badge", "label": "Badge (optional)" },
    { "type": "number", "id": "tier_4_quantity", "label": "Quantity", "default": 4 },
    { "type": "header", "content": "Tier 5 — discount from product metafield:" },
    { "type": "checkbox", "id": "tier_5_enabled", "label": "Show this tier", "default": false },
    { "type": "text", "id": "tier_5_label", "label": "Label", "default": "5x" },
    { "type": "text", "id": "tier_5_badge", "label": "Badge (optional)" },
    { "type": "number", "id": "tier_5_quantity", "label": "Quantity", "default": 5 }
  ],
  "presets": [
    {
      "name": "Buy Box Tiers"
    }
  ]
}
{% endschema %}