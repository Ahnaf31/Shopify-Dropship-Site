      "default": "REAL CUSTOMERS, REAL RESULTS"
    },
    {
      "type": "range",
      "id": "rating",
      "label": "Rating",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "default": 4.8
    },
    {
      "type": "text",
      "id": "customer_count",
      "label": "Customer count",
      "default": "20,000+"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "info": "Leave blank to use your store name",
      "default": "CoolClip"
    },
    {
      "type": "text",
      "id": "subheading_template",
      "label": "Subheading",
      "info": "Use [count] and [brand] as placeholders",
      "default": "Why [count] people chose [brand]"
    },
    {
      "type": "checkbox",
      "id": "enable_nav_arrows",
      "label": "Show navigation arrows",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_scrollbar",
      "label": "Hide scrollbar",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#EAF4F7"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#F7F8FA"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#14384D"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#E8A33D"
    },
    {
      "type": "color",
      "id": "text_color",
